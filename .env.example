# Copy to .env. Never commit .env.
# Claude Code OAuth token from `claude setup-token`. Used by the repair agent (M4) and the bench
# agent (M5), both of which run through the Claude Agent SDK. Leave ANTHROPIC_API_KEY empty:
# Claude Code prefers an API key when both are set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Bench agent (M5), repair agent (M4), smoke runs
BENCH_MODEL=claude-sonnet-5-5
REPAIR_MODEL=claude-opus-5-5
SMOKE_MODEL=claude-haiku-5-5
# Demo tool repo that receives fix PRs. PRs are opened with the `gh` CLI.
SHOP_MCP_REPO=vats98754/shop-mcp
# Optional: only needed if `gh` is not authenticated
GITHUB_TOKEN=
# Optional
MANUFACT_API_KEY=
