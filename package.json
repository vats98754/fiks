{
  "name": "fiks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretest": "node scripts/ensure-shop-mcp.mjs",
    "test": "vitest run",
    "fiks": "tsx packages/cli/src/main.ts",
    "predemo": "node scripts/ensure-shop-mcp.mjs",
    "demo": "tsx packages/cli/src/main.ts demo",
    "demo:confirm": "tsx packages/cli/src/main.ts confirm",
    "bench": "tsx packages/cli/src/main.ts bench",
    "dashboard": "pnpm --filter @fiks/dashboard dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
