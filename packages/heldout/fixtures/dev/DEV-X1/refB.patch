diff --git a/src/tools/get_product.ts b/src/tools/get_product.ts
index acbc928..c3444be 100644
--- a/src/tools/get_product.ts
+++ b/src/tools/get_product.ts
@@ -33,11 +33,18 @@ export async function handler(args: { id: string }, vendor: VendorClient) {
   const res = await vendor.get(`/products/${encodeURIComponent(args.id)}`);
   if (res.status === 404) return fail(`No product with id ${args.id}.`);
   const p = res.body as VendorProduct;
+  // Cross-check the amount with the catalogue search, which always quotes the shelf price; use the
+  // listed price when the search names this product.
+  const found = await vendor.get(`/products?q=${encodeURIComponent(p.name)}`);
+  const listed = (found.body as { items?: { id: string; price: number }[] } | null)?.items?.find(
+    (x) => x.id === p.id,
+  );
+  const scale = (found.headers.get('vendor-api-version') ?? '') >= '2026-10-01' ? 100 : 1;
   return ok({
     id: p.id,
     name: p.name,
     category: p.category,
-    price: p.price ?? p.unit_amount ?? null,
+    price: listed ? listed.price / scale : (p.price ?? p.unit_amount ?? null),
     currency: p.currency,
     in_stock: p.stock > 0,
   });
